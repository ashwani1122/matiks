generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Operator {
  ADD
  SUBTRACT
  MULTIPLY
  DIVIDE
}

enum FriendStatus {
  ACCEPTED
  REJECTED
  PENDING
}

enum GameStatus {
  RUNNING
  ENDED
  SEARCHING_FOR_PLAYERS
}

enum GameMemberStatus {
  WON
  LOST
}

enum GameType {
  MATH_DUEL
  MEMORY_GRID
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  username String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameMembers GameMember[]

  leaderboards Leaderboard[]

  answers QuestionAnswer[]

  memoryAnswers MemoryAnswer[]

  friendsSent     Friends[] @relation("sender")
  friendsReceived Friends[] @relation("receiver")
}

model Game {
  id String @id @default(uuid())

  type GameType

  timeLimit Int

  startedAt DateTime?
  endedAt   DateTime?

  status GameStatus @default(SEARCHING_FOR_PLAYERS)

  gameMembers GameMember[]

  questions Question[]

  memoryQuestions MemoryQuestion[]

  answers QuestionAnswer[]

  memoryAnswers MemoryAnswer[]

  @@index([type])
  @@index([status])
}

model GameMember {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  status GameMemberStatus?

  score Int @default(0)

  correctAnswers Int @default(0)

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
}

model Question {
  id String @id @default(uuid())

  integer1 Int
  integer2 Int

  operator Operator

  systemAnswer Int

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  answers QuestionAnswer[]

  @@index([gameId])
}

model QuestionAnswer {
  id String @id @default(uuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  answer Int

  createdAt DateTime @default(now())

  @@index([questionId])
  @@index([gameId])
  @@index([userId])
}

model MemoryQuestion {
  id String @id @default(uuid())

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  questionNumber Int

  pattern Json

  createdAt DateTime @default(now())

  answers MemoryAnswer[]

  @@unique([gameId, questionNumber])
  @@index([gameId])
}

model MemoryAnswer {
  id String @id @default(uuid())

  memoryQuestionId String
  memoryQuestion   MemoryQuestion @relation(fields: [memoryQuestionId], references: [id])

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  selectedCells Json

  correct Boolean

  score Int @default(0)

  createdAt DateTime @default(now())

  @@unique([memoryQuestionId, userId])
  @@index([gameId])
  @@index([userId])
  @@index([memoryQuestionId])
}

model Leaderboard {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  gameType GameType

  rating Int @default(1000)

  gamesPlayed Int @default(0)

  wins Int @default(0)

  losses Int @default(0)

  totalScore Int @default(0)

  correctAnswers Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, gameType])
  @@index([gameType, rating])
  @@index([gameType, totalScore])
}

model Friends {
  id String @id @default(uuid())

  senderId String
  sender   User   @relation("sender", fields: [senderId], references: [id])

  receiverId String
  receiver   User   @relation("receiver", fields: [receiverId], references: [id])

  status FriendStatus @default(PENDING)

  @@index([senderId])
  @@index([receiverId])
}
